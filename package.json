{
    "name": "nuxt-app",
    "private": true,
    "license": "GPL-3.0-only",
    "type": "module",
    "scripts": {
        "prebuild": "node scripts/write-generated-meta.mjs",
        "predev": "node scripts/write-generated-meta.mjs",
        "pregenerate": "node scripts/write-generated-meta.mjs",
        "build": "nuxt build",
        "dev": "nuxt dev",
        "typecheck": "nuxi typecheck",
        "typecheck:server": "pnpm exec tsc -p server/tsconfig.json --noEmit",
        "proto:generate": "pnpm exec buf format -w proto && pnpm exec buf generate proto --template proto/buf.gen.yaml",
        "proto:check": "pnpm exec buf format --diff proto && pnpm exec buf lint proto && pnpm exec tsc -p shared/generated/tsconfig.json --noEmit && node scripts/check-v2-client-registry.mjs",
        "exports:v2:migrate": "node scripts/exports-v2-migrate.mjs",
        "generate": "nuxt generate",
        "migrate:emu-storage-v2": "node scripts/migrate-emu-storage-v2.mjs",
        "migrate:internal-storage-v2": "node scripts/migrate-emu-storage-v2.mjs",
        "migrate:auth-v2": "node scripts/migrate-emu-storage-v2.mjs",
        "migrate:users-schema": "node scripts/migrate-users-schema.mjs",
        "migrate:feedback-schema": "node scripts/migrate-feedback-schema.mjs",
        "migrate:station-board-rows-save-status": "node scripts/migrate-station-board-rows-save-status.mjs",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "format": "prettier --write \"./**/*.{vue,ts,js,json}\"",
        "format:check": "prettier --check \"./**/*.{vue,ts,js,json}\""
    },
    "devDependencies": {
        "@bufbuild/buf": "1.72.0",
        "@bufbuild/protoc-gen-es": "2.13.0",
        "@tailwindcss/container-queries": "^0.1.1",
        "@tailwindcss/vite": "^4.1.14",
        "@types/better-sqlite3": "^7.6.13",
        "@vite-pwa/nuxt": "^1.0.6",
        "baseline-browser-mapping": "^2.9.11",
        "nuxt-security": "^2.4.0",
        "prettier": "^3.7.4",
        "tailwindcss": "^4.1.14",
        "typescript": "^5.9.3",
        "vue-tsc": "^3.2.8",
        "workbox-core": "^7.3.0",
        "workbox-precaching": "^7.3.0"
    },
    "dependencies": {
        "@bufbuild/protobuf": "2.13.0",
        "better-sqlite3": "^12.6.2",
        "date-fns": "^4.1.0",
        "driver.js": "^1.4.0",
        "jsqr": "^1.4.0",
        "localforage": "^1.10.0",
        "log4js": "^6.9.1",
        "lru-cache": "^11.2.7",
        "nuxt": "^4.1.3",
        "pdfjs-dist": "^5.7.284",
        "uuid": "^13.0.0",
        "vue": "^3.5.22",
        "vue-router": "^4.6.3",
        "web-push": "^3.6.7"
    }
}
